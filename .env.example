# docker compose settings (copy to .env)
POSTGRES_PASSWORD=kyko
# Required: openssl rand -hex 32 (docker compose refuses to start without it)
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
CURRENCY=₸
# SMTP for password recovery (empty => reset links go to the backend log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
