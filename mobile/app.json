{
  "expo": {
    "name": "Kyko Parfums",
    "slug": "kyko-parfums",
    "scheme": "kyko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kz.kyko.parfums",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kz.kyko.parfums",
      "adaptiveIcon": {
        "backgroundColor": "#1c1917",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#faf8f5"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#a67c52",
          "defaultChannel": "orders"
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна сотрудникам магазина, чтобы сканировать штрихкоды и фотографировать товары.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен сотрудникам магазина, чтобы загружать фотографии товаров, логотипы и баннеры.",
          "cameraPermission": "Камера нужна сотрудникам магазина, чтобы сканировать штрихкоды и фотографировать товары.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1be8691a-9e5a-4839-bd0d-f4884255e269"
      }
    }
  }
}
