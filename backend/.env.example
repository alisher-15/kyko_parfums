DATABASE_URL=postgresql+psycopg://kyko:kyko@localhost:5432/kyko
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
# Used in password-reset links
FRONTEND_URL=http://localhost:3000

# Telegram bot for new-order messages (from @BotFather). Empty = no messages. Use a separate
# bot for local runs: two servers reading one bot's messages take them from each other.
TELEGRAM_BOT_TOKEN=

# SMTP for password recovery and order emails. Leave SMTP_HOST empty to send nothing; with
# EMAIL_LOG_BODY=true the emails (reset links too) are printed to the backend log instead.
# Never set EMAIL_LOG_BODY on a live site.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=true
EMAIL_LOG_BODY=true

# Error reports to Sentry (sentry.io → project → Client Keys (DSN)). Empty = none.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
