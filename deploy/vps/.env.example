# Copy to deploy/vps/.env and fill in. Never commit the filled file.

# The shop's domain, without https:// (its DNS A record points at this server).
DOMAIN=kyko.kz
# The shop's previous address, still served the same (apps installed before the domain call it).
# install.sh fills it when it moves the shop from its sslip.io address to DOMAIN.
LEGACY_DOMAIN=

# Long random strings: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The owner's login, created on the first start (at least 8 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, as on Render (README «Почта, ошибки и мониторинг»).
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENTRY_DSN=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# Photos in Cloudflare R2 (README «Фото флаконов»); empty = on the server's disk.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
